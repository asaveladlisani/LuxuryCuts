# Port the API listens on (Render sets this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins. Leave empty to allow all.
# On Render this is set to https://asaveladlisani.github.io via render.yaml.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string. On Render this is wired to luxurycuts-db via render.yaml.
# Locally, either run Postgres in Docker:
#   docker run -d --name luxurycuts-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=luxurycuts -p 5432:5432 postgres:16-alpine
# or paste the "External Database URL" from the Render dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/luxurycuts
